DATABASE_URL=sqlite:///./data/messages.db

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Autenticación por API key: deshabilitada mientras
# esta variable no esté definida. Al activarla, todos los endpoints de
# /api/messages* exigen el header "X-API-Key" con este valor
# (el WebSocket lo exige como query param ?api_key=...).
# API_KEY=super-secret-key-reto-nequi

# Lista JSON de palabras que el filtro de contenido inapropiado censura.
BANNED_WORDS=["idiota","estupido","spamword","puta","gonorrea"]
